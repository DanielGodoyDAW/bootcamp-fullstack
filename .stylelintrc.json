{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "stylelint-order"
  ],
  "rules": {
    "order/properties-order": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "width",
      "height",
      "margin",
      "padding",
      "border",
      "border-radius",
      "background",
      "background-color",
      "color",
      "font",
      "font-size",
      "transform"
    ],
    "selector-class-pattern": [
      "^[a-zA-Z][a-zA-Z0-9]*((-|__)[a-zA-Z0-9]+)*$",
      {
        "resolveNestedSelectors": true,
        "message": "Esperado nombre de clase siguiendo el patrón personalizado"
      }
    ],
    "no-descending-specificity": null,
    "at-rule-no-unknown": true
  }
}